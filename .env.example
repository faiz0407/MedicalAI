# ─── REQUIRED ────────────────────────────────────────────────────────────────
# Groq API — used by ALL agents (intent classifier, all 5 agents, memory summaries)
# Get from https://console.groq.com → API Keys (free tier available)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MODEL_FAST=llama-3.1-8b-instant

# Pinecone — get from https://app.pinecone.io
# IMPORTANT: index must be created with dimension=768 (BioBERT output size)
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_ENVIRONMENT=gcp-starter

# JWT Secret — generate with: openssl rand -hex 32
SECRET_KEY=your_jwt_secret_key_here_generate_with_openssl_rand_hex_32

# ─── BioBERT EMBEDDINGS (no API key — runs locally) ──────────────────────────
# Model: dmis-lab/biobert-base-cased-v1.2  (~440 MB, auto-downloaded on first run)
# Device: "cpu" (default) or "cuda" if you have a GPU
BIOBERT_MODEL=dmis-lab/biobert-base-cased-v1.2
BIOBERT_DEVICE=cpu
BIOBERT_BATCH_SIZE=32

# ─── DATABASE ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://healthuser:healthpass@localhost:5432/healthcareai
DATABASE_SYNC_URL=postgresql://healthuser:healthpass@localhost:5432/healthcareai

# ─── AWS DYNAMODB (chat sessions & messages — free tier) ─────────────────────
# Create a free AWS account → IAM → create user with DynamoDB permissions
# Tables are auto-created on first startup: healthcare_chat_sessions, healthcare_chat_messages
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
AWS_REGION=us-east-1

# ─── EMAIL (optional for dev — mocked if not set) ────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL=

# ─── APP ──────────────────────────────────────────────────────────────────────
DEBUG=true
APP_NAME=HealthcareAI

# ─── NEWS API (optional — mock data used if not set) ─────────────────────────
# Get free key from: https://newsapi.org/register
NEWS_API_KEY=your_newsapi_key_here

# ─── Google OAuth (optional) ─────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# ─── Razorpay (1-rupee appointment fee) ──────────────────────────────────────
# Sign up free at https://dashboard.razorpay.com → Settings → API Keys
# Use rzp_test_* keys for dev — no real charges in test mode
# Leave blank to run in mock mode (no Razorpay account needed for dev)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ─── Facebook Graph API (optional — for direct social media publishing) ───────
# 1. Go to https://developers.facebook.com → My Apps → Create App
# 2. Add "Pages API" product to the app
# 3. Use Graph API Explorer to generate a Page Access Token (long-lived preferred)
# 4. Your Page ID: open your Facebook Page → About → scroll to Page ID
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=your_facebook_page_access_token_here

# ─── CORS ─────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:3001","http://localhost:5173"]
